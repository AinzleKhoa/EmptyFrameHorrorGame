  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The sun hangs an inch above the trees, forever gold, forever warm. On
    the bench, the tea remains hot, the steam rising in a perfect, unmoving curl.
    You sat down, and in doing so, you let the clock stop. Outside the park, the
    seasons change. Your parents\u2019 calls eventually stop. Your friends grow old,
    they marry, they grieve, and they live. But here, there is no tomorrow. There
    is only the 'now'\u2014a beautiful, suffocating loop of a memory that has become
    your cage. You aren't healing; you are just a silhouette pinned to a dead moment.
    You chose the safety of the past, but in the Labyrinth of what was, the light
    never changes, and you will never breathe a new breath again."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9ef09b0aab353c440b69f15e14fd87ce, type: 2}
  m_sharedMaterial: {fileID: -4749353540993623812, guid: 9ef09b0aab353c440b69f15e14fd87ce, type: 2}
