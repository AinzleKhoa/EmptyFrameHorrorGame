  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 150186496989610373, guid: 0abc28e9b72f78947863f8d0b60c3b65, type: 3}
      propertyPath: _content
      value: "\"My dearest Minh,\n\nIf you are reading this, it means you\u2019ve
        finally come back to our park. I know how hard it has been for you to look
        at this bench without feeling the weight of that sunset.\n\nYou\u2019ve always
        had a way of capturing the world through your lens, but I feared you were
        using that camera to hide from the world rather than see it. Please, don't
        let that one moment\u2014the moment the light left my eyes\u2014be the only
        frame you keep in your heart.\n\nYou blame yourself for not being enough,
        for being 'broken' or 'depressed,' as you call it. But Minh, even a cracked
        lens can capture a beautiful sunset. The shadows you've been running from
        aren't there to swallow you; they are just part of the picture.\n\nForgive
        yourself for being human. Put the camera down for a moment, take a breath,
        and look at the sky. It's time to stop living in the Labyrinth of what was,
        and start seeing the light of what is.\n\nI am still here, in every golden
        ray and every rustle of the leaves. I love you, always.\n\n\u2014 Grandma\""
      objectReference: {fileID: 0}
    - target: {fileID: 1063458325495393329, guid: 0abc28e9b72f78947863f8d0b60c3b65, type: 3}
      propertyPath: m_Mesh
      value: 
      objectReference: {fileID: 1606413135}
    - target: {fileID: 2475963954628228297, guid: 0abc28e9b72f78947863f8d0b60c3b65, type: 3}
      propertyPath: m_Name
      value: ReadablePaper
